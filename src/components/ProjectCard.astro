---
import type { CollectionEntry } from 'astro:content';
import { withBase } from '../lib/path';

type Props = {
	project: CollectionEntry<'projects'>;
};

const { project } = Astro.props;
const url = withBase(`/projects/${project.id}`);
const img = withBase(project.data.image);

const statusLabel = {
	completed: 'Completed',
	'in-progress': 'In progress',
	planned: 'Planned',
};
---

<article class="group flex flex-col overflow-hidden rounded-2xl border border-zinc-800 bg-zinc-900/50 transition-colors hover:border-emerald-400/50">
	<a href={url} class="block overflow-hidden">
		<img
			src={img}
			alt={project.data.title}
			width={800}
			height={600}
			loading="lazy"
			class="aspect-[4/3] w-full object-cover transition-transform duration-300 group-hover:scale-105"
		/>
	</a>
	<div class="flex flex-1 flex-col gap-3 p-5">
		<div class="flex items-center justify-between gap-2">
			<span
				class:list={[
					'rounded-full px-2.5 py-0.5 text-xs font-semibold',
					project.data.status === 'completed' && 'bg-emerald-400/10 text-emerald-400',
					project.data.status === 'in-progress' && 'bg-amber-400/10 text-amber-400',
					project.data.status === 'planned' && 'bg-zinc-500/10 text-zinc-400',
				]}
			>
				{statusLabel[project.data.status]}
			</span>
			<span class="font-mono text-xs text-zinc-500">{project.data.year}</span>
		</div>
		<a href={url}>
			<h2 class="text-xl font-semibold text-zinc-50 transition-colors group-hover:text-emerald-400">
				{project.data.title}
			</h2>
		</a>
		<p class="line-clamp-2 text-sm text-zinc-400">{project.data.description}</p>
		<ul class="mt-auto flex flex-wrap gap-1.5 pt-2">
			{project.data.tags.slice(0, 4).map((tag) => (
				<li class="rounded bg-zinc-800 px-2 py-0.5 font-mono text-xs text-zinc-400">{tag}</li>
			))}
		</ul>
	</div>
</article>
