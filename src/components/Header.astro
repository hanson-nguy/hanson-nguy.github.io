---
import { withBase } from '../lib/path';

const base = import.meta.env.BASE_URL;
const path = Astro.url.pathname.replace(new RegExp(`^${base}`), '').replace(/\/$/, '');

const links = [
	{ href: '/', label: 'Home' },
	{ href: '/projects', label: 'Projects' },
	{ href: '/blog', label: 'Blog' },
	{ href: '/about', label: 'About' },
	{ href: '/contact', label: 'Contact' },
];

const isActive = (href: string) =>
	href === '/' ? path === '' : path === href || path.startsWith(href);
---

<header class="sticky top-0 z-50 border-b border-zinc-800 bg-zinc-950/80 backdrop-blur">
	<nav
		class="mx-auto flex w-full max-w-6xl items-center justify-between px-5 py-4"
		aria-label="Main"
	>
		<a href={withBase('/')} class="font-mono text-xl font-bold tracking-tight text-zinc-50">
			hanson<span class="text-emerald-400">.dev</span>
		</a>

		<ul class="hidden items-center gap-1 md:flex">
			{links.map((link) => (
				<li>
					<a
						href={withBase(link.href)}
						class:list={[
							'rounded-lg px-3 py-2 text-sm transition-colors',
							isActive(link.href)
								? 'bg-emerald-400/10 font-semibold text-emerald-400'
								: 'text-zinc-400 hover:text-zinc-100',
						]}
					>
						{link.label}
					</a>
				</li>
			))}
		</ul>

		<button
			id="menu-toggle"
			class="rounded-lg border border-zinc-800 p-2 text-zinc-300 md:hidden"
			aria-label="Toggle menu"
			aria-expanded="false"
			aria-controls="mobile-menu"
		>
			<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
				<path d="M4 7h16M4 12h16M4 17h16" />
			</svg>
		</button>
	</nav>

	<div id="mobile-menu" class="hidden border-t border-zinc-800 md:hidden">
		<ul class="flex flex-col gap-1 px-5 py-3">
			{links.map((link) => (
				<li>
					<a
						href={withBase(link.href)}
						class:list={[
							'block rounded-lg px-3 py-2 text-sm transition-colors',
							isActive(link.href)
								? 'bg-emerald-400/10 font-semibold text-emerald-400'
								: 'text-zinc-400 hover:text-zinc-100',
						]}
					>
						{link.label}
					</a>
				</li>
			))}
		</ul>
	</div>
</header>

<script>
	const toggle = document.getElementById('menu-toggle');
	const menu = document.getElementById('mobile-menu');

	toggle?.addEventListener('click', () => {
		const hidden = menu?.classList.toggle('hidden');
		toggle.setAttribute('aria-expanded', String(!hidden));
	});
</script>
