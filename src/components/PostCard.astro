---
import type { CollectionEntry } from 'astro:content';
import { formatDate, readingTime } from '../lib/format';
import { withBase } from '../lib/path';
import CategoryBadge from './CategoryBadge.astro';

type Props = {
	post: CollectionEntry<'blog'>;
};

const { post } = Astro.props;
const url = withBase(`/blog/${post.id}`);
const img = withBase(post.data.image);
---

<article
	class:list={[
		'group flex flex-col overflow-hidden rounded-xl border-2 bg-surface shadow-[6px_6px_0_0_var(--color-ink)/0.08] transition-all hover:-translate-y-0.5 hover:shadow-[8px_8px_0_0_var(--color-ink)/0.12]',
		post.data.category === 'academic' ? 'border-hairline hover:border-cobalt' : 'border-hairline hover:border-azure',
	]}
>
	<a href={url} class="block overflow-hidden border-b border-hairline">
		<img
			src={img}
			alt={post.data.title}
			width={800}
			height={600}
			loading="lazy"
			class="aspect-[4/3] w-full bg-white object-cover transition-transform duration-300 group-hover:scale-105"
		/>
	</a>
	<div class="flex flex-1 flex-col gap-3 p-5">
		<div class="flex items-center gap-2">
			<CategoryBadge category={post.data.category} />
			<span class="font-mono text-xs text-slate">
				{formatDate(post.data.date)} · {readingTime(post.body)}
			</span>
		</div>
		<a href={url}>
			<h2
				class:list={[
					'text-xl font-semibold text-ink transition-colors',
					post.data.category === 'academic' ? 'group-hover:text-cobalt' : 'group-hover:text-azure',
				]}
			>
				{post.data.title}
			</h2>
		</a>
		<p class="line-clamp-2 text-sm text-slate">{post.data.description}</p>
		<ul class="mt-auto flex flex-wrap gap-1.5 pt-2">
			{post.data.tags.slice(0, 4).map((tag) => (
				<li class="rounded border border-hairline px-2 py-0.5 font-mono text-xs text-slate">{tag}</li>
			))}
		</ul>
	</div>
</article>
