---
import CategoryBadge from './CategoryBadge.astro';

interface Props {
	title: string;
	description: string;
	image: string;
	url: string;
	category: 'academic' | 'hobby';
	meta?: string;
	tags?: string[];
	flip?: boolean;
}

const { title, description, image, url, category, meta, tags, flip = false } = Astro.props;
const accent = category === 'academic' ? 'group-hover:text-cobalt' : 'group-hover:text-azure';
---

<article class="grid items-center gap-8 lg:grid-cols-2">
	<a
		href={url}
		class:list={[
			'group block overflow-hidden rounded-xl border-2 border-hairline bg-surface shadow-[6px_6px_0_0_var(--color-ink)/0.08] transition-transform hover:-translate-y-0.5',
			flip && 'lg:order-2',
		]}
	>
		<img
			src={image}
			alt={title}
			width={1200}
			height={750}
			loading="lazy"
			class="aspect-[16/10] w-full bg-white object-cover transition-transform duration-500 group-hover:scale-105"
		/>
	</a>
	<div class:list={[flip && 'lg:order-1']}>
		<div class="flex items-center gap-2">
			<CategoryBadge category={category} />
			{meta && <span class="font-mono text-xs text-slate">{meta}</span>}
		</div>
		<a href={url} class="group">
			<h3 class:list={['mt-3 font-display text-2xl text-ink transition-colors sm:text-3xl', accent]}>
				{title}
			</h3>
		</a>
		<p class="mt-3 text-slate">{description}</p>
		{tags && tags.length > 0 && (
			<ul class="mt-4 flex flex-wrap gap-1.5">
				{tags.slice(0, 5).map((tag) => (
					<li class="rounded border border-hairline px-2 py-0.5 font-mono text-xs text-slate">
						{tag}
					</li>
				))}
			</ul>
		)}
		<a href={url} class="mt-6 inline-block font-semibold text-cobalt hover:underline">
			Read more →
		</a>
	</div>
</article>
