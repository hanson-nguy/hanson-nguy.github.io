---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Contact — Hanson Nguyen">
	<section class="mx-auto w-full max-w-3xl px-5 pt-16 pb-24">
		<p class="font-mono text-sm font-medium text-azure">contact</p>
		<h1 class="mt-2 font-display text-4xl text-ink sm:text-5xl">Contact</h1>
		<p class="mt-4 text-lg text-slate">
			Questions about a project, collaboration ideas, or just want to talk electronics? Drop me
			a line.
		</p>

		<div class="mt-10 grid gap-4 sm:grid-cols-2">
			<a
				href="mailto:hello@example.com"
				class="group rounded-xl border-2 border-hairline bg-surface p-6 transition-colors hover:border-cobalt"
			>
				<p class="font-mono text-sm text-cobalt">email</p>
				<p class="mt-2 text-lg text-ink group-hover:text-cobalt">
					hansonng@berkeley.edu
				</p>
			</a>
			<a
				href="https://github.com/hanson-nguy"
				class="group rounded-xl border-2 border-hairline bg-surface p-6 transition-colors hover:border-cobalt"
			>
				<p class="font-mono text-sm text-cobalt">github</p>
				<p class="mt-2 text-lg text-ink group-hover:text-cobalt">
					@hanson-nguy
				</p>
			</a>
			<a
				href="https://scholar.google.com/citations?user=TbWXOSAAAAAJ&hl=en"
				class="group rounded-xl border-2 border-hairline bg-surface p-6 transition-colors hover:border-cobalt"
			>
				<p class="font-mono text-sm text-cobalt">google scholar</p>
				<p class="mt-2 text-lg text-ink group-hover:text-cobalt">
					research profile
				</p>
			</a>
		</div>

		<p class="mt-10 font-mono text-sm text-slate">
			best response times: evenings &amp; weekends
		</p>
	</section>
</Layout>
