---
import { getCollection, render } from 'astro:content';
import type { GetStaticPaths } from 'astro';
import Layout from '../../layouts/Layout.astro';
import { formatDate, readingTime } from '../../lib/format';
import { withBase } from '../../lib/path';
import CategoryBadge from '../../components/CategoryBadge.astro';

export const getStaticPaths = (async () => {
	const posts = await getCollection('blog');
	return posts
		.filter((p) => !p.data.draft)
		.map((post) => ({
			params: { slug: post.id },
			props: { post },
		}));
}) satisfies GetStaticPaths;

interface Props {
	post: Awaited<ReturnType<typeof getCollection<'blog'>>>[number];
}

const { post } = Astro.props;
const { Content } = await render(post);
---

<Layout
	title={`${post.data.title} — Hanson Nguyen`}
	description={post.data.description}
	image={post.data.image}
>
	<article class="mx-auto w-full max-w-3xl px-5 pt-16 pb-24">
		<div class="mb-3 flex items-center gap-2">
			<CategoryBadge category={post.data.category} />
			<p class="font-mono text-sm text-slate">
				{formatDate(post.data.date)} · {readingTime(post.body)}
			</p>
		</div>
		<h1 class="font-display text-4xl leading-tight text-ink">{post.data.title}</h1>
		<p class="mt-4 text-lg text-slate">{post.data.description}</p>

		<ul class="mt-6 flex flex-wrap gap-2">
			{post.data.tags.map((tag) => (
				<li class="rounded-full border border-hairline px-3 py-1 font-mono text-xs text-slate">
					{tag}
				</li>
			))}
		</ul>

		<img
			src={withBase(post.data.image)}
			alt={post.data.title}
			width={800}
			height={600}
			class="mt-8 aspect-[4/3] w-full rounded-xl border border-hairline bg-surface object-cover"
		/>

		<div class="markdown mt-10">
			<Content />
		</div>
	</article>
</Layout>
