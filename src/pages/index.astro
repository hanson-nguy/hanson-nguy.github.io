---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import Ticker from '../components/Ticker.astro';
import FeatureRow from '../components/FeatureRow.astro';
import { formatDate } from '../lib/format';
import { withBase } from '../lib/path';

const projects = (await getCollection('projects'))
	.filter((p) => p.data.featured)
	.slice(0, 3);
const posts = (await getCollection('blog'))
	.filter((p) => !p.data.draft)
	.sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
	.slice(0, 3);

const statusLabel = {
	completed: 'Completed',
	'in-progress': 'In progress',
	planned: 'Planned',
};
---

<Layout title="Hanson Nguyen — Electronics & Hobby Projects">
	<section class="mx-auto w-full max-w-6xl px-5 pt-20 pb-16">
		<div class="grid items-center gap-12 lg:grid-cols-[1fr_auto]">
			<div>
				<p class="mb-4 font-mono text-sm font-medium text-azure">hi, i'm hanson</p>
				<h1 class="max-w-3xl font-display text-4xl leading-tight text-ink sm:text-6xl">
					I do stuff, then write about stuff.
				</h1>
				<p class="mt-6 max-w-2xl text-lg text-slate">
					Quantum computing, FPGAs, homelabbing, and whatever I feel like
					doing. Everything here is documented on this site, and
					open when it can be.
				</p>
				<div class="mt-8 flex flex-wrap gap-4">
					<a
						href={withBase('/projects')}
						class="rounded-xl border-2 border-cobalt bg-cobalt px-6 py-3 font-semibold text-white transition-colors hover:border-cobalt-hover hover:bg-cobalt-hover"
					>
						View projects
					</a>
					<a
						href={withBase('/blog')}
						class="rounded-xl border-2 border-hairline px-6 py-3 font-semibold text-ink transition-colors hover:border-cobalt hover:text-cobalt"
					>
						Read the blog
					</a>
				</div>
			</div>
			<img
				src={withBase('/images/me.jpg')}
				alt="Hanson Nguyen"
				width={320}
				height={320}
				class="aspect-square w-64 rounded-xl border-2 border-hairline bg-surface object-cover shadow-[6px_6px_0_0_var(--color-ink)/0.08] sm:w-72"
			/>
		</div>
	</section>

	<Ticker />

	<section class="mx-auto w-full max-w-6xl px-5 py-20">
		<div class="mb-12 flex items-end justify-between">
			<div>
				<p class="font-mono text-sm font-medium text-azure">01 · featured projects</p>
				<h2 class="mt-2 font-display text-3xl text-ink sm:text-4xl">Fresh off the bench</h2>
			</div>
			<a href={withBase('/projects')} class="shrink-0 text-sm font-semibold text-cobalt hover:underline">
				All projects →
			</a>
		</div>
		<div class="flex flex-col gap-20">
			{projects.map((project, i) => (
				<FeatureRow
					title={project.data.title}
					description={project.data.description}
					image={withBase(project.data.image)}
					url={withBase(`/projects/${project.id}`)}
					category={project.data.category}
					meta={`${project.data.year} · ${statusLabel[project.data.status]}`}
					tags={project.data.tags}
					flip={i % 2 === 1}
				/>
			))}
		</div>
	</section>

	<section class="border-y border-hairline bg-surface">
		<div class="mx-auto w-full max-w-6xl px-5 py-20">
			<div class="mb-12 flex items-end justify-between">
				<div>
					<p class="font-mono text-sm font-medium text-azure">02 · from the blog</p>
					<h2 class="mt-2 font-display text-3xl text-ink sm:text-4xl">Notes &amp; writeups</h2>
				</div>
				<a href={withBase('/blog')} class="shrink-0 text-sm font-semibold text-cobalt hover:underline">
					All posts →
				</a>
			</div>
			<div class="flex flex-col gap-20">
				{posts.map((post, i) => (
					<FeatureRow
						title={post.data.title}
						description={post.data.description}
						image={withBase(post.data.image)}
						url={withBase(`/blog/${post.id}`)}
						category={post.data.category}
						meta={formatDate(post.data.date)}
						tags={post.data.tags}
						flip={i % 2 === 1}
					/>
				))}
			</div>
		</div>
	</section>

	<section class="bg-cobalt">
		<div class="mx-auto flex w-full max-w-6xl flex-col items-start justify-between gap-6 px-5 py-20 text-paper lg:flex-row lg:items-center">
			<div>
				<p class="font-mono text-sm font-medium text-sky">03 · get in touch</p>
				<h2 class="mt-2 font-display text-3xl sm:text-4xl">Wanna talk about a build?</h2>
				<p class="mt-3 max-w-xl text-paper/80">
					Questions about a project, a collaboration, or just want to nerd out about
					microcontrollers — my inbox is open.
				</p>
			</div>
			<a
				href={withBase('/contact')}
				class="shrink-0 rounded-xl border-2 border-paper bg-paper px-6 py-3 font-semibold text-cobalt transition-colors hover:bg-tint"
			>
				Say hello
			</a>
		</div>
	</section>
</Layout>
