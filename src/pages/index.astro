---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import PostCard from '../components/PostCard.astro';
import { withBase } from '../lib/path';

const projects = (await getCollection('projects'))
	.filter((p) => p.data.featured)
	.slice(0, 3);
const posts = (await getCollection('blog'))
	.filter((p) => !p.data.draft)
	.sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
	.slice(0, 3);
---

<Layout title="Hanson Nguyen — Electronics & Hobby Projects">
	<section class="mx-auto w-full max-w-6xl px-5 pt-20 pb-24">
		<p class="mb-4 font-mono text-sm text-emerald-400">hi, i'm hanson</p>
		<h1 class="max-w-3xl text-4xl font-bold leading-tight text-zinc-50 sm:text-6xl">
			I build electronics and hobby projects, then write about them.
		</h1>
		<p class="mt-6 max-w-2xl text-lg text-zinc-400">
			Firmware, PCBs, and the occasional hand-wired keyboard. Everything here is built in the
			workshop, documented on this site, and open when it can be.
		</p>
		<div class="mt-8 flex flex-wrap gap-4">
			<a
				href={withBase("/projects")}
				class="rounded-xl bg-emerald-400 px-6 py-3 font-semibold text-zinc-950 transition-colors hover:bg-emerald-300"
			>
				View projects
			</a>
			<a
				href={withBase("/blog")}
				class="rounded-xl border border-zinc-700 px-6 py-3 font-semibold text-zinc-200 transition-colors hover:border-emerald-400/60 hover:text-emerald-400"
			>
				Read the blog
			</a>
		</div>
	</section>

	<section class="mx-auto w-full max-w-6xl px-5 pb-20">
		<div class="mb-8 flex items-end justify-between">
			<h2 class="text-2xl font-semibold text-zinc-50">Featured projects</h2>
			<a href={withBase("/projects")} class="text-sm text-emerald-400 hover:underline">All projects →</a>
		</div>
		<div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
			{projects.map((project) => <ProjectCard project={project} />)}
		</div>
	</section>

	<section class="mx-auto w-full max-w-6xl px-5 pb-24">
		<div class="mb-8 flex items-end justify-between">
			<h2 class="text-2xl font-semibold text-zinc-50">Latest from the blog</h2>
			<a href={withBase("/blog")} class="text-sm text-emerald-400 hover:underline">All posts →</a>
		</div>
		<div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
			{posts.map((post) => <PostCard post={post} />)}
		</div>
	</section>
</Layout>
