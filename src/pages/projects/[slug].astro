---
import { getCollection, render } from 'astro:content';
import type { GetStaticPaths } from 'astro';
import Layout from '../../layouts/Layout.astro';
import { withBase } from '../../lib/path';
import CategoryBadge from '../../components/CategoryBadge.astro';

export const getStaticPaths = (async () => {
	const projects = await getCollection('projects');
	return projects.map((project) => ({
		params: { slug: project.id },
		props: { project },
	}));
}) satisfies GetStaticPaths;

interface Props {
	project: Awaited<ReturnType<typeof getCollection<'projects'>>>[number];
}

const { project } = Astro.props;
const { Content } = await render(project);

const statusLabel = {
	completed: 'Completed',
	'in-progress': 'In progress',
	planned: 'Planned',
};
---

<Layout title={`${project.data.title} — Hanson Nguyen`} description={project.data.description} image={project.data.image}>
	<article class="mx-auto w-full max-w-3xl px-5 pt-16 pb-24">
		<p class="mb-3 font-mono text-sm text-slate">
			project · <span class="text-azure">{project.data.year}</span>
		</p>
		<h1 class="font-display text-4xl leading-tight text-ink">{project.data.title}</h1>
		<p class="mt-4 text-lg text-slate">{project.data.description}</p>

		<div class="mt-6 flex flex-wrap items-center gap-2">
			<CategoryBadge category={project.data.category} />
			<span
				class:list={[
					'rounded-full px-3 py-1 text-xs font-semibold',
					project.data.status === 'completed' && 'bg-tint text-cobalt',
					project.data.status === 'in-progress' && 'bg-tint text-azure',
					project.data.status === 'planned' && 'bg-slate/10 text-slate',
				]}
			>
				{statusLabel[project.data.status]}
			</span>
			{project.data.tags.map((tag) => (
				<span class="rounded-full border border-hairline px-3 py-1 font-mono text-xs text-slate">
					{tag}
				</span>
			))}
			<span class="flex-1"></span>
			{project.data.links?.github && (
				<a
					href={project.data.links.github}
					class="rounded-lg border-2 border-hairline px-4 py-1.5 text-sm font-semibold text-ink hover:border-cobalt hover:text-cobalt"
				>
					GitHub
				</a>
			)}
			{project.data.links?.demo && (
				<a
					href={project.data.links.demo}
					class="rounded-lg border-2 border-cobalt bg-cobalt px-4 py-1.5 text-sm font-semibold text-white hover:border-cobalt-hover hover:bg-cobalt-hover"
				>
					Live demo
				</a>
			)}
		</div>

		<img
			src={withBase(project.data.image)}
			alt={project.data.title}
			class="mt-8 w-full rounded-xl border border-hairline bg-surface object-contain"
		/>

		{project.data.parts && (
			<section class="mt-8 rounded-xl border border-hairline bg-surface p-6">
				<h2 class="mb-3 font-mono text-sm font-semibold uppercase tracking-wider text-cobalt">
					Parts &amp; components
				</h2>
				<ul class="grid gap-2 sm:grid-cols-2">
					{project.data.parts.map((part) => (
						<li class="flex items-center gap-2 text-sm text-ink">
							<span class="h-1.5 w-1.5 rounded-full bg-azure"></span>
							{part}
						</li>
					))}
				</ul>
			</section>
		)}

		<div class="markdown mt-10">
			<Content />
		</div>
	</article>
</Layout>
