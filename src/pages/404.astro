---
import Layout from '../layouts/Layout.astro';
import { withBase } from '../lib/path';
---

<Layout title="Page not found — Hanson Nguyen">
	<section class="mx-auto flex w-full max-w-3xl flex-col items-center px-5 pt-32 pb-32 text-center">
		<p class="font-display text-7xl text-cobalt">404</p>
		<h1 class="mt-4 font-display text-2xl text-ink">This page doesn't exist</h1>
		<p class="mt-3 text-slate">
			The link may be broken, or the page was moved.
		</p>
		<a
			href={withBase('/')}
			class="mt-8 rounded-xl border-2 border-cobalt bg-cobalt px-6 py-3 font-semibold text-white transition-colors hover:border-cobalt-hover hover:bg-cobalt-hover"
		>
			Back home
		</a>
	</section>
</Layout>
