---
import Layout from '../layouts/Layout.astro';
import { withBase } from '../lib/path';
---

<Layout title="Page not found — Hanson Nguyen">
	<section class="mx-auto flex w-full max-w-3xl flex-col items-center px-5 pt-32 pb-32 text-center">
		<p class="font-mono text-7xl font-bold text-emerald-400">404</p>
		<h1 class="mt-4 text-2xl font-semibold text-zinc-50">This page doesn't exist</h1>
		<p class="mt-3 text-zinc-400">
			The link may be broken, or the page was moved.
		</p>
		<a
			href={withBase('/')}
			class="mt-8 rounded-xl bg-emerald-400 px-6 py-3 font-semibold text-zinc-950 transition-colors hover:bg-emerald-300"
		>
			Back home
		</a>
	</section>
</Layout>
